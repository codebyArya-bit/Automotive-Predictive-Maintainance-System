# Master Agent Orchestration System - Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
RELOAD=true

# =============================================================================
# Agent Configuration
# =============================================================================
MAX_RETRIES=3
RETRY_DELAY=1.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
HEALTH_CHECK_INTERVAL=30

# Priority and Decision Thresholds
CONTACT_PROBABILITY_THRESHOLD=0.7
HIGH_PRIORITY_LEVELS=P0,P1
ESCALATION_SENTIMENT_THRESHOLD=3

# =============================================================================
# Monitoring and Logging
# =============================================================================
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
AUDIT_LOGGING=true

# Performance Monitoring
PERFORMANCE_MONITORING=true
METRICS_COLLECTION=true
DASHBOARD_ENABLED=true

# =============================================================================
# Security and Compliance
# =============================================================================
UEBA_MONITORING=true
SECURITY_ALERTS=true
COMPLIANCE_FRAMEWORKS=SOX,GDPR,ISO27001,NIST

# Risk Assessment
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.8

# =============================================================================
# External Services (Optional)
# =============================================================================

# OpenAI API (if using LLM features)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# Database Configuration (if using persistence)
# DATABASE_URL=postgresql://username:password@localhost:5432/master_agent_db
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# Redis Configuration (if using caching)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# Message Queue (if using async processing)
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Service Center Configuration
# =============================================================================
DEFAULT_SERVICE_CENTERS=Downtown,North,South,East,West
DEFAULT_BUSINESS_HOURS_START=08:00
DEFAULT_BUSINESS_HOURS_END=18:00
APPOINTMENT_SLOT_DURATION=60

# =============================================================================
# Customer Engagement
# =============================================================================
VOICE_CONTACT_PRIORITIES=P0,P1
APP_NOTIFICATION_PRIORITIES=P2,P3
DEFAULT_CONTACT_METHOD=app_notification

# SMS/Voice Service (if using external providers)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# Development and Testing
# =============================================================================
TESTING_MODE=false
MOCK_EXTERNAL_SERVICES=true
DEMO_MODE=false

# Test Data
TEST_VEHICLE_IDS=TEST001,TEST002,TEST003
DEMO_CUSTOMER_PHONE=+1234567890
DEMO_CUSTOMER_EMAIL=demo@example.com

# =============================================================================
# Performance Tuning
# =============================================================================
WORKER_THREADS=4
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
AGENT_EXECUTION_TIMEOUT=10

# Circuit Breaker Settings
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
CB_EXPECTED_EXCEPTION_TYPES=TimeoutError,ConnectionError

# =============================================================================
# Deployment Configuration
# =============================================================================
ENVIRONMENT=development
VERSION=1.0.0
SERVICE_NAME=master-agent-orchestration

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health
READINESS_CHECK_ENDPOINT=/ready

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_MANUFACTURING_INSIGHTS=true
ENABLE_FEEDBACK_COLLECTION=true
ENABLE_UEBA_MONITORING=true
ENABLE_CIRCUIT_BREAKERS=true
ENABLE_PERFORMANCE_MONITORING=true

# Advanced Features
ENABLE_PREDICTIVE_ANALYTICS=true
ENABLE_REAL_TIME_PROCESSING=false
ENABLE_MULTI_TENANT=false